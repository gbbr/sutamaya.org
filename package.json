{
  "name": "sutamaya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "build:corpus": "npm run update-data:post && node scripts/build-corpus.mjs",
    "update-data": "npm run update-data:check && npm run update-data:copy && npm run update-data:post && (npm run update-data:triage || true)",
    "update-data:check": "node scripts/update-data-check.mjs",
    "update-data:copy": "node scripts/update-data-copy.mjs",
    "update-data:post": "node scripts/update-data-post.mjs",
    "update-data:triage": "node scripts/update-data-triage.mjs",
    "update-data:counts": "node scripts/update-data-counts.mjs",
    "update-data:snapshot": "node scripts/update-data-snapshot.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "npm run dev --workspace web",
    "dev": "npm run build:corpus && concurrently -k -n worker,web -c blue,green \"npm run dev:worker\" \"npm run dev:web\"",
    "build": "npm run build:corpus && npm run build --workspace web",
    "usage-report": "node scripts/usage-report.mjs",
    "test": "npx vitest run",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "concurrently": "^9.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}
