{
  "name": "sutamaya",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build:corpus": "node scripts/build-corpus.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev": "npm run build:corpus && concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build:corpus && npm run build --workspace web",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
