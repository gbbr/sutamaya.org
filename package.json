{
  "name": "sutamaya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "web",
    "worker"
  ],
  "scripts": {
    "build:corpus": "node scripts/update-data.mjs post --quiet && node scripts/build-corpus.mjs",
    "update-data": "node scripts/update-data.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "npm run dev --workspace web",
    "dev": "npm run build:corpus && concurrently -k -n worker,web -c blue,green \"npm run dev:worker\" \"npm run dev:web\"",
    "build": "npm run build:corpus && npm run build --workspace web",
    "usage-report": "node scripts/usage-report.mjs",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npx vitest run",
    "test:e2e": "E2E_OFFLINE=1 npx playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}
