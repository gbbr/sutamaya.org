.DS_Store
# Contents rather than the directory itself: git can't re-include anything under an excluded
# directory, and skills/, commands/ and agents/ are checked in (see .claude/skills/retranslate/).
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
node_modules/
__pycache__/
web/dist/
web/dev-dist/
web/ota/
web/public/data/
# Derived from web/public/icons/ by scripts/make-native-assets.mjs; the generated native
# resources under web/ios/ and web/android/ are what's committed.
web/assets/
data/sujato.post/
# Review scratch: local copies of the review rounds' answers, which cuts.json keeps, and the pages
# and batches scripts/segmenter/segment-translations.mjs writes.
data/*/review/**/*.answers.*
data/*/review/**/*.opus.*
data/*/review/batches/
data/*/review/*.html
data/*/review/findings.json
data/*/review/tidy.json
.env
*.local
CLAUDE.local.md
*.tsbuildinfo
.dev.vars
.wrangler/
test-results/
playwright-report/
blob-report/
.playwright/

