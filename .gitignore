.DS_Store
# Contents rather than the directory itself: git can't re-include anything under an excluded
# directory, and skills/, commands/ and agents/ are checked in (see .claude/skills/retranslate/).
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
node_modules/
__pycache__/
web/dist/
web/dev-dist/
web/ota/
web/public/data/
# Derived from web/public/icons/ by scripts/make-native-assets.mjs; the generated native
# resources under web/ios/ and web/android/ are what's committed.
web/assets/
data/sujato.post/
# A review round's packets and answers, in the copy where it runs (data/upstream/README.md).
data/*/review/
.env
*.local
CLAUDE.local.md
*.tsbuildinfo
.dev.vars
.wrangler/
test-results/
playwright-report/
blob-report/
.playwright/

