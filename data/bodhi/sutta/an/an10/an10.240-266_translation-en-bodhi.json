  "an10.240-266:0.3": "10.240–266 ",
  "an10.240-266:1.1": "“Bhikkhus, for full understanding of lust … ",
  "an10.240-266:1.2": "for the utter destruction … ",
  "an10.240-266:1.3": "for the abandoning … ",
  "an10.240-266:1.4": "for the destruction … ",
  "an10.240-266:1.5": "for the vanishing … ",
  "an10.240-266:1.6": "for the fading away … ",
  "an10.240-266:1.7": "for the cessation … ",
  "an10.240-266:1.8": "for the giving up … ",
  "an10.240-266:1.9": "for the relinquishment of lust … ",
  "an10.240-266:1.10": "these ten things are to be developed.” "
}
