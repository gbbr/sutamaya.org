        "an3.30:7.2": "pariyosānañca tādiso; ",
        "an3.30:7.3": "Nisinno āsane tasmiṁ, ",
        "an3.30:7.4": "uggahetvāna byañjanaṁ; ",
        "an3.30:7.5": "Vuṭṭhito nappajānāti, ",
        "an3.30:7.6": "gahitaṁ hissa mussati. "
      },
      "before": {
        "an3.30:7.1": "",
        "an3.30:7.2": "While sitting in his seat, ",
        "an3.30:7.3": "he grasps the phrasing of the talk, ",
        "an3.30:7.4": "at its beginning, middle, and end. ",
        "an3.30:7.5": "But after rising, he no longer understands, ",
        "an3.30:7.6": "but forgets what he had learned. "
      },
