  "runs": [
    {
      "id": 1,
      "file": "data/thanissaro/sutta/an/an5/an5.264_translation-en-thanissaro.json",
      "paragraph": 2,
      "above": {
        "key": "an5.264:2.1",
        "pali": "Pañcime, bhikkhave, dhamme pahāya bhabbo paṭhamaṁ jhānaṁ upasampajja viharituṁ. ",
        "sujato": "But after giving up these five qualities you can enter and remain in the first absorption. ",
        "english": "“With the abandoning of these five qualities, one is capable of entering & remaining in the first jhāna.…” "
      },
      "lines": [
        {
          "key": "an5.264:2.2",
          "pali": "Katame pañca? ",
          "sujato": "What five? ",
          "english": ""
        },
        {
          "key": "an5.264:2.3",
          "pali": "Āvāsamacchariyaṁ, kulamacchariyaṁ, lābhamacchariyaṁ, vaṇṇamacchariyaṁ, akataññutaṁ akataveditaṁ. ",
          "sujato": "Stinginess with dwellings, families, material things, praise, and lack of gratitude and thankfulness. ",
          "english": ""
        },
        {
          "key": "an5.264:2.4",
          "pali": "Ime kho, bhikkhave, pañca dhamme pahāya bhabbo paṭhamaṁ jhānaṁ upasampajja viharitun”ti. ",
          "sujato": "After giving up these five qualities you can enter and remain in the first absorption.” ",
          "english": ""
        }
      ],
      "below": null,
      "belowInSameParagraph": false
    },
    {
      "id": 2,
      "file": "data/thanissaro/sutta/an/an5/an5.265-271_translation-en-thanissaro.json",
      "paragraph": 2,
      "above": {
        "key": "an5.265-271:2.1",
        "pali": "Pañcime, bhikkhave, dhamme pahāya bhabbo dutiyaṁ jhānaṁ … tatiyaṁ jhānaṁ … catutthaṁ jhānaṁ … sotāpattiphalaṁ … sakadāgāmiphalaṁ … anāgāmiphalaṁ … arahattaṁ sacchikātuṁ. ",
        "sujato": "But after giving up these five qualities you can enter and remain in the second absorption … third absorption … fourth absorption … and realize the fruit of stream-entry … the fruit of once-return … the fruit of non-return … perfection. ",
        "english": "“With the abandoning of these five qualities, one is capable of entering & remaining in the second jhāna… the third jhāna… the fourth jhāna; capable of realizing the fruit of stream-entry… the fruit of once-returning… the fruit of non-returning… arahantship.…” "
      },
      "lines": [
        {
          "key": "an5.265-271:2.2",
          "pali": "Katame pañca? ",
          "sujato": "What five? ",
          "english": ""
        },
        {
          "key": "an5.265-271:2.3",
          "pali": "Āvāsamacchariyaṁ, kulamacchariyaṁ, lābhamacchariyaṁ, vaṇṇamacchariyaṁ, akataññutaṁ akataveditaṁ. ",
          "sujato": "Stinginess with dwellings, families, material things, praise, and lack of gratitude and thankfulness. ",
          "english": ""
        },
        {
          "key": "an5.265-271:2.4",
          "pali": "Ime kho, bhikkhave, pañca dhamme pahāya bhabbo arahattaṁ sacchikātun”ti. ",
          "sujato": "After giving up these five qualities you can realize perfection.” ",
          "english": ""
        }
      ],
      "below": null,
      "belowInSameParagraph": false
    }
