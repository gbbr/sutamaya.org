  "snp3.12:0.2": "<p>See also: <a href='https://suttacentral.net/dn15'>DN 15</a>; <a href='https://suttacentral.net/mn9'>MN 9</a>; <a href='https://suttacentral.net/mn140'>MN 140</a>; SN 12:1; <a href='https://suttacentral.net/sn12.15'>SN 12:15</a>; <a href='https://suttacentral.net/sn22.94'>SN 22:94</a>; <a href='https://suttacentral.net/sn35.93'>SN 35:93</a>; <a href='https://suttacentral.net/an4.5'>AN 4:5</a>; <a href='https://suttacentral.net/an4.24'>AN 4:24</a>; <a href='https://suttacentral.net/iti51'>Iti 51</a>; <a href='https://suttacentral.net/iti103'>Iti 103</a></p>",
