  "snp2.14:0.2": "<p>See also: <a href='https://suttacentral.net/mn66'>MN 66</a>; <a href='https://suttacentral.net/mn70'>MN 70</a>; <a href='https://suttacentral.net/an3.70'>AN 3:71</a>; <a href='https://suttacentral.net/an10.46'>AN 10:46</a></p>",
