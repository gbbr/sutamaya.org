  "snp4.16:0.2": "<p>See also: <a href='https://suttacentral.net/sn35.117'>SN 35:117</a>; <a href='https://suttacentral.net/sn35.241'>SN 35:200</a>; <a href='https://suttacentral.net/an4.28'>AN 4:28</a>; <a href='https://suttacentral.net/thag3.9'>Thag 3:8</a>; <a href='https://suttacentral.net/thag5.8'>Thag 5:8</a>; <a href='https://suttacentral.net/thag6.2'>Thag 6:2</a>; Thag 18</p>",
