  "mn141:0.2": "<p>See also: <a href='https://suttacentral.net/dn22'>DN 22</a>; <a href='https://suttacentral.net/sn12.20'>SN 12:20</a>; <a href='https://suttacentral.net/sn56.11'>SN 56:11</a>; <a href='https://suttacentral.net/an3.136'>AN 3:137</a></p>",
