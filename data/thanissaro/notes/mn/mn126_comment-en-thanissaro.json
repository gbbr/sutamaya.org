  "mn126:0.2": "<p>See also: <a href='https://suttacentral.net/mn117'>MN 117</a>; <a href='https://suttacentral.net/sn22.101'>SN 22:101</a>; <a href='https://suttacentral.net/sn42.6'>SN 42:6</a>; <a href='https://suttacentral.net/sn45.8'>SN 45:8</a>; <a href='https://suttacentral.net/an5.43'>AN 5:43</a>; <a href='https://suttacentral.net/thig12.1'>Thig 12</a></p>",
