  "mn61:0.2": "<p>See also: <a href='https://suttacentral.net/mn19'>MN 19</a>; <a href='https://suttacentral.net/mn24'>MN 24</a>; <a href='https://suttacentral.net/mn95'>MN 95</a>; <a href='https://suttacentral.net/mn121'>MN 121</a>; <a href='https://suttacentral.net/an3.65'>AN 3:66</a>; <a href='https://suttacentral.net/an4.115'>AN 4:115</a>; <a href='https://suttacentral.net/an5.140'>AN 5:140</a>; <a href='https://suttacentral.net/an7.83'>AN 7:80</a>; <a href='https://suttacentral.net/an8.53'>AN 8:53</a>; <a href='https://suttacentral.net/iti25'>Iti 25</a></p>",
  "mn61:1.1": "",
  "mn61:1.2": "",
  "mn61:2.1": "Rāhula: the Buddha’s son, who according to the Commentary was seven years old when this discourse was delivered to him.",
