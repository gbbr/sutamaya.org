  "sn35.243:0.3": "<p>See also: <a href='https://suttacentral.net/mn49'>MN 49</a>; <a href='https://suttacentral.net/mn101'>MN 101</a>; <a href='https://suttacentral.net/mn119'>MN 119</a>; <a href='https://suttacentral.net/sn4.19'>SN 4:19</a>; <a href='https://suttacentral.net/sn5.7'>SN 5:7</a>; <a href='https://suttacentral.net/an3.109'>AN 3:110</a>; <a href='https://suttacentral.net/an3.128'>AN 3:129</a></p>",
