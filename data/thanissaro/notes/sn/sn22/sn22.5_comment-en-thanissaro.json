  "sn22.5:0.3": "<p>See also: <a href='https://suttacentral.net/mn14'>MN 14</a>; <a href='https://suttacentral.net/mn28'>MN 28</a>; <a href='https://suttacentral.net/sn12.2'>SN 12:2</a>; <a href='https://suttacentral.net/sn12.15'>SN 12:15</a>; <a href='https://suttacentral.net/sn12.61'>SN 12:61</a>; <a href='https://suttacentral.net/sn22.131'>SN 22:131</a>; <a href='https://suttacentral.net/sn22.132'>SN 22:132</a>; <a href='https://suttacentral.net/sn35.99'>SN 35:99</a>; <a href='https://suttacentral.net/sn47.42'>SN 47:42</a></p>",
