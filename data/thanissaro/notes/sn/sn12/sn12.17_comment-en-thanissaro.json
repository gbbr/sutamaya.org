  "sn12.17:0.3": "<p>See also: <a href='https://suttacentral.net/sn12.18'>SN 12:18</a>; <a href='https://suttacentral.net/sn12.25'>SN 12:25</a>; <a href='https://suttacentral.net/sn12.46'>SN 12:46</a>; <a href='https://suttacentral.net/sn12.67'>SN 12:67</a></p>",
