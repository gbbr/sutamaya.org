  "sn55.25:0.3": "<p>See also: <a href='https://suttacentral.net/dn29'>DN 29</a>; <a href='https://suttacentral.net/mn118'>MN 118</a>; <a href='https://suttacentral.net/an3.86'>AN 3:87</a>; <a href='https://suttacentral.net/an4.123'>AN 4:123</a>; <a href='https://suttacentral.net/an4.125'>AN 4:125</a>; <a href='https://suttacentral.net/an10.75'>AN 10:75</a></p>",
