  "sn47.4:2.2": "",
  "sn47.4:2.3": "<i>Ekagga-citta.</i> For the meaning of this term, see <a href='https://suttacentral.net/an5.151#an5.151note01'>AN 5:151, note 1</a>. Notice that this sutta does not make a sharp distinction between mindfulness practice and concentration practice. See also <a href='https://suttacentral.net/mn44'>MN 44</a> and <a href='https://suttacentral.net/an8.63'>AN 8:70</a>.",
  "sn47.4:2.4": "",
  "sn47.4:2.5": "",
  "sn47.4:2.6": "",
