  "sn47.4:0.3": "<p>See also: <a href='https://suttacentral.net/sn22.122'>SN 22:122</a>; <a href='https://suttacentral.net/sn46.4'>SN 46:4</a>; <a href='https://suttacentral.net/sn52.9'>SN 52:9</a>; <a href='https://suttacentral.net/sn52.10'>SN 52:10</a>; <a href='https://suttacentral.net/sn54.11'>SN 54:11</a>; <a href='https://suttacentral.net/an5.114'>AN 5:114</a></p>",
