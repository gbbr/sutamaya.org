  "an7.53:0.3": "<p>See also: <a href='https://suttacentral.net/sn41.7'>SN 41:7</a>; <a href='https://suttacentral.net/sn41.10'>SN 41:10</a>; <a href='https://suttacentral.net/an6.37'>AN 6:37</a>; <a href='https://suttacentral.net/an8.23'>AN 8:23</a>; <a href='https://suttacentral.net/sn55.3'>SN 55:3</a></p>",
