  "an3.100:0.3": "<p>See also: <a href='https://suttacentral.net/mn86'>MN 86</a>; <a href='https://suttacentral.net/mn136'>MN 136</a>; <a href='https://suttacentral.net/sn20.4'>SN 20:4</a>; <a href='https://suttacentral.net/sn42.8'>SN 42:8</a>; <a href='https://suttacentral.net/an5.79'>AN 5:79</a>; <a href='https://suttacentral.net/an11.15'>AN 11:16</a></p>",
