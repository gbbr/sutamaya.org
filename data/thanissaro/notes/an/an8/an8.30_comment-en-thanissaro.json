  "an8.30:0.3": "<p>See also: <a href='https://suttacentral.net/dn21'>DN 21</a>; <a href='https://suttacentral.net/mn2'>MN 2</a>; <a href='https://suttacentral.net/mn18'>MN 18</a>; <a href='https://suttacentral.net/sn22.3'>SN 22:3</a>; <a href='https://suttacentral.net/an4.28'>AN 4:28</a>; <a href='https://suttacentral.net/an4.173'>AN 4:173</a>; <a href='https://suttacentral.net/an5.30'>AN 5:30</a>; <a href='https://suttacentral.net/an8.53'>AN 8:53</a>; <a href='https://suttacentral.net/an10.69'>AN 10:69</a>; <a href='https://suttacentral.net/an10.72'>AN 10:72</a>; <a href='https://suttacentral.net/ud3.1'>Ud 3:1</a>; <a href='https://suttacentral.net/iti80'>Iti 80</a>; <a href='https://suttacentral.net/thag6.10'>Thag 6:10</a></p>",
