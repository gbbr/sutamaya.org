  "an4.195:0.3": "<p>See also: <a href='https://suttacentral.net/dn29'>DN 29</a>; <a href='https://suttacentral.net/mn14'>MN 14</a>; <a href='https://suttacentral.net/mn35'>MN 35</a>; <a href='https://suttacentral.net/mn36'>MN 36</a>; <a href='https://suttacentral.net/mn56'>MN 56</a>; <a href='https://suttacentral.net/mn58'>MN 58</a>; <a href='https://suttacentral.net/mn101'>MN 101</a>; <a href='https://suttacentral.net/sn22.54'>SN 22:54</a>; <a href='https://suttacentral.net/sn42.8'>SN 42:8</a>; <a href='https://suttacentral.net/sn42.9'>SN 42:9</a>; <a href='https://suttacentral.net/an3.34'>AN 3:34</a>; <a href='https://suttacentral.net/an3.61'>AN 3:62</a>; <a href='https://suttacentral.net/an3.70'>AN 3:71</a>; <a href='https://suttacentral.net/an9.38'>AN 9:38</a>; <a href='https://suttacentral.net/ud3.1'>Ud 3:1</a></p>",
  "an4.195:1.1": "",
  "an4.195:1.2": "",
  "an4.195:2.1": "",
