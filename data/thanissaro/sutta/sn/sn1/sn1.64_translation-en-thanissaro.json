  "sn1.64:0.3": "Fettered ",
  "sn1.64:1.1": "“With what is the world fettered? ",
  "sn1.64:1.2": "What is its exploration? ",
  "sn1.64:1.3": "With the abandoning\nof what ",
  "sn1.64:1.4": "is there said,\n‘unbinding’?” ",
  "sn1.64:2.1": "The Buddha:\n“Fettered with delight is the world. ",
  "sn1.64:2.2": "Directed thought is its exploration. ",
  "sn1.64:2.3": "With the abandoning\nof craving ",
  "sn1.64:2.4": "is there said,\n‘unbinding.’” "
}
