  "thag2.19:0.4": "Thag 2:19 Nanda ",
  "thag2.19:1.1": "From inappropriate attention ",
  "thag2.19:1.2": "I was devoted to ornament, ",
  "thag2.19:1.3": "restless & vain, ",
  "thag2.19:1.4": "driven by sensual passion. ",
  "thag2.19:2.1": "With the help of the Buddha, ",
  "thag2.19:2.2": "the Kinsman of the Sun,\nskilled in strategies, ",
  "thag2.19:2.3": "I, practicing appropriately, ",
  "thag2.19:2.4": "plucked my mind\nout of becoming. ",
  "thag2.19:2.5": ""
}
