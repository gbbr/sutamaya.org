  "thag1.31:0.4": "Thag 1:31 Gahuratīriya ",
  "thag1.31:1.1": "Touched by gnats & mosquitoes, ",
  "thag1.31:1.2": "in the wilds, the great forest, ",
  "thag1.31:1.3": "like a nāga elephant ",
  "thag1.31:1.4": "at the head of a battle, mindful, ",
  "thag1.31:1.5": "he acquiesces to that. "
}
