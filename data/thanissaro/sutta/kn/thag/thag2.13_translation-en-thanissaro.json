  "thag2.13:0.4": "Thag 2:13 Heraññakāni ",
  "thag2.13:1.1": "Days & nights\nfly past. ",
  "thag2.13:1.2": "Life\ncomes to an end. ",
  "thag2.13:1.3": "The span of mortals\nruns out, ",
  "thag2.13:1.4": "like the water of a piddling stream. ",
  "thag2.13:2.1": "But the fool doing evil deeds ",
  "thag2.13:2.2": "doesn’t realize that later ",
  "thag2.13:2.3": "it’s bitter for him: ",
  "thag2.13:2.4": "evil for him\nthe result. ",
  "thag2.13:2.5": ""
}
