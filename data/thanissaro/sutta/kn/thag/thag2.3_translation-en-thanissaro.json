  "thag2.3:0.4": "Thag 2:3 Valliya ",
  "thag2.3:1.1": "A monkey,\ncoming to the little hut ",
  "thag2.3:1.2": "with five doors, ",
  "thag2.3:1.3": "goes from door to door, knocking ",
  "thag2.3:1.4": "moment by moment. ",
  "thag2.3:2.1": "Stand still, monkey,\ndon’t run. ",
  "thag2.3:2.2": "It’s not yours\nas it was before. ",
  "thag2.3:2.3": "You’re bound by discernment. ",
  "thag2.3:2.4": "You won’t get far away. ",
  "thag2.3:2.5": ""
}
