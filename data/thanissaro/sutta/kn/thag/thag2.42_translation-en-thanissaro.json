  "thag2.42:0.4": "Thag 2:42 Dhammapāla ",
  "thag2.42:1.1": "The young monk ",
  "thag2.42:1.2": "devoted to the Buddha’s message, ",
  "thag2.42:1.3": "is wakeful among those who sleep. ",
  "thag2.42:1.4": "His life is not in vain. ",
  "thag2.42:2.1": "So, intelligent,\none should commit oneself ",
  "thag2.42:2.2": "to conviction & virtue, ",
  "thag2.42:2.3": "confidence & Dhamma-vision, ",
  "thag2.42:2.4": "remembering the Buddhas’ message. ",
  "thag2.42:2.5": ""
}
