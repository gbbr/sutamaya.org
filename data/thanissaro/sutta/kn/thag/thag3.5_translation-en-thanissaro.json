  "thag3.5:0.4": "Thag 3:5 Mātaṅgaputta ",
  "thag3.5:1.1": "It’s too cold,\ntoo hot, ",
  "thag3.5:1.2": "too late in the evening—\npeople who say this, ",
  "thag3.5:1.3": "shirking their work: ",
  "thag3.5:1.4": "The moment passes them by. ",
  "thag3.5:2.1": "Whoever regards cold & heat ",
  "thag3.5:2.2": "as no more than grass, ",
  "thag3.5:2.3": "doing his manly duties, ",
  "thag3.5:2.4": "won’t fall away\nfrom ease. ",
  "thag3.5:3.1": "With my chest\nI push through ",
  "thag3.5:3.2": "wild grasses—\nspear-grass,\nribbon-grass, ",
  "thag3.5:3.3": "rushes— ",
  "thag3.5:3.4": "cultivating a heart\nbent on seclusion. ",
  "thag3.5:3.5": ""
}
