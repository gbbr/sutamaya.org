  "thag1.23:0.4": "Thag 1:23 Gosāla ",
  "thag1.23:1.1": "I—having eaten honey-rice ",
  "thag1.23:1.2": "in a bamboo patch ",
  "thag1.23:1.3": "and rightly grasping ",
  "thag1.23:1.4": "the aggregates’\narising-disbanding— ",
  "thag1.23:1.5": "will return to the hillside, ",
  "thag1.23:1.6": "intent\non seclusion. ",
  "thag1.23:1.7": ""
}
