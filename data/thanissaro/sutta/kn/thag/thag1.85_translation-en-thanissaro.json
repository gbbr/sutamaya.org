  "thag1.85:0.4": "Thag 1:85 Sunāga ",
  "thag1.85:1.1": "Adept in a theme for the mind, ",
  "thag1.85:1.2": "sensing the savor of solitude, ",
  "thag1.85:1.3": "practicing jhāna,\nmasterful, mindful, ",
  "thag1.85:1.4": "you’d attain a pleasure\nnot of the flesh. ",
  "thag1.85:1.5": ""
}
