{
  "an4.261:0.1": "Numbered Discourses 4.261 ",
  "an4.261:0.2": "26. Insight ",
  "an4.261:0.3": "Powers ",
  "an4.261:1.1": "“Bhikkhus, there are these four powers. ",
  "an4.261:1.2": "What four? ",
  "an4.261:1.3": "The powers of energy, mindfulness, concentration, and wisdom. ",
  "an4.261:1.4": "These are the four powers.” "
}