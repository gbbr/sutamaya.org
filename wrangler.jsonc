{
  "name": "sutamaya",
  "main": "./worker/src/index.js",
  "compatibility_date": "2025-10-11",
  // Cutover lives here rather than in the dashboard so it's diffable and repeatable. Cloudflare
  // creates and manages the apex DNS record and its certificate; the Google A/AAAA records this
  // replaces must be deleted first (they're recorded in the migration plan — restoring them is
  // the rollback). Takes effect on the next `wrangler deploy`, not before.
  "routes": [{ "pattern": "sutamaya.org", "custom_domain": true }],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/" is here so the Worker can answer the bare origin with the landing page instead of the
    // SPA shell `not_found_handling` would serve — see the route in worker/src/index.js. Every
    // other path still goes straight to the asset router without invoking the Worker.
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sutamaya",
      "database_id": "fd146fd9-2f62-4774-8110-35f453bbf178",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Per-IP budgets for /api/*, applied in worker/src/index.js. `simple.period` only accepts 10 or
  // 60 seconds, so these are the per-minute conversions of the Express app's 15-minute windows —
  // see deploy.md. There's no equivalent of the old /data/* limiter: those requests are answered
  // by the assets binding above and never invoke the Worker.
  "ratelimits": [
    { "name": "RATE_LIMIT_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Covers /api/auth/* other than /me. A Google sign-in costs two requests (start, callback) and
    // an emailed-code sign-in costs at least two more (request, verify) — plus a typo or a resend —
    // so this can't be as tight as a "one sign-in per attempt" budget would suggest. Guessing a
    // code is bounded by login_codes.attempts rather than by this.
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
    { "name": "RATE_LIMIT_ME", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Sign-in codes go out through Resend (`RESEND_API_KEY`, a Worker secret) rather than
  // Cloudflare's own Email Sending, which needs a Workers Paid plan — see docs/deploy.md.
  "vars": {
    "WEB_ORIGIN": "https://sutamaya.org",
    "GOOGLE_CLIENT_ID": "45956701911-0a93js1du42ia6vtno0n4bh36crkn5f6.apps.googleusercontent.com",
    "MAIL_FROM": "no-reply@sutamaya.org"
  },
  "observability": { "enabled": true }
}
