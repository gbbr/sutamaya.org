{
  "name": "sutamaya",
  "main": "./worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sutamaya",
      "database_id": "fd146fd9-2f62-4774-8110-35f453bbf178",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Per-IP budgets for /api/*, applied in worker/src/index.js. `simple.period` only accepts 10 or
  // 60 seconds, so these are the per-minute conversions of the Express app's 15-minute windows —
  // see deploy.md. There's no equivalent of the old /data/* limiter: those requests are answered
  // by the assets binding above and never invoke the Worker.
  "ratelimits": [
    { "name": "RATE_LIMIT_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMIT_ME", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "WEB_ORIGIN": "https://sutamaya.org",
    "GOOGLE_CLIENT_ID": "45956701911-0a93js1du42ia6vtno0n4bh36crkn5f6.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
