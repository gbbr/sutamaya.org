# Public Google OAuth 2.0 Web Client ID for "Sign in with Google" (see deploy.md).
# This is a client identifier, not a secret — safe to commit. Leave blank to hide
# the Google sign-in button (there is no other sign-in method). scripts/deploy.sh
# reads this same value automatically and passes it to the server at deploy time.
VITE_GOOGLE_CLIENT_ID=45956701911-0a93js1du42ia6vtno0n4bh36crkn5f6.apps.googleusercontent.com
